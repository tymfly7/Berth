# Standalone Raspberry Pi image — full-stack (frontend + backend, ARM64)
#
# Build natively on RPi:
#   docker build -t berth-rpi:latest -f Dockerfile.rpi .
#
# Or cross-compile on x86 and transfer:
#   docker buildx build --platform linux/arm64 -t berth-rpi:latest -f Dockerfile.rpi . --load
#   docker save berth-rpi:latest | gzip > berth-rpi.tar.gz
#   scp berth-rpi.tar.gz pi@raspberrypi.local:~/
#   # on RPi: docker load < berth-rpi.tar.gz
#
# Admin password is validated server-side at runtime — set BERTH_ADMIN_PASSWORD
# in the container env (compose), NOT at build time. It is never shipped to the browser.

# ── Stage 1: Build frontend ──────────────────────────────
FROM node:20-slim AS frontend-build
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
# No VITE_API_KEY: the browser authenticates with the admin session token from
# PIN login, never a baked-in static key. Backend BERTH_API_KEY is a runtime
# (compose) env, server-side only — see docker-compose.rpi.yml.
RUN npm run build

# ── Stage 2: ARM64 backend + static frontend ─────────────
FROM python:3.11-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libsm6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.edge.txt requirements.edge.txt
# Torch-free edge image: every model runs on NCNN, so neither torch nor
# ultralytics is installed here. See requirements.edge.txt.
RUN pip install --no-cache-dir -r requirements.edge.txt

COPY backend/ /app/
COPY --from=frontend-build /app/frontend/dist ./static/

RUN mkdir -p /app/edge_data /app/configs/roi

ENV BERTH_DEPLOYMENT=edge \
    BERTH_MODEL=cnn_scratch \
    BERTH_HOST=0.0.0.0 \
    BERTH_PORT=8000

EXPOSE 8000
CMD ["python", "main.py"]
