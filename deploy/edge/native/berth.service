[Unit]
Description=Berth edge worker
After=network-online.target
Wants=network-online.target

[Service]
User=edge
WorkingDirectory=/home/edge/berth/backend
Environment=BERTH_DEPLOYMENT=edge BERTH_MODEL=cnn_scratch BERTH_HOST=0.0.0.0 BERTH_PORT=8001 BERTH_INFERENCE_WORKERS=1 BERTH_MAX_ACTIVE_CAMERAS=1 BERTH_MAX_STREAM_HEIGHT=480 BERTH_MAX_FRAME_HEIGHT=480 BERTH_SNAPSHOT_INTERVAL=15 MALLOC_ARENA_MAX=2
ExecStart=/home/edge/berth/venv/bin/python main.py
Restart=on-failure
RestartSec=10
MemoryHigh=320M
MemoryMax=380M
MemorySwapMax=64M
OOMPolicy=kill

[Install]
WantedBy=multi-user.target
